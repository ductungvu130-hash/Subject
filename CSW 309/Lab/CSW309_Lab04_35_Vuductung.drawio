        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% Lệnh ép màu nền trắng, viền đen cho tất cả các khối\n    classDef default fill:#FFFFFF,stroke:#000000,stroke-width:1px;\n\n    %% Lớp Requester\n    class Requester {\n        -requesterID: String\n        -fullName: String\n        -email: String\n        +submitRequest(): void\n        +editRequest(): void\n        +checkStatus(): void\n    }\n\n    %% Lớp BookingRequest\n    class BookingRequest {\n        -requestID: String\n        -eventTitle: String\n        -purpose: String\n        -expectedParticipants: int\n        -eventDate: Date\n        -startTime: Time\n        -endTime: Time\n        -status: String\n        -requiredFacilities: String\n        +updateStatus(newStatus: String): void\n        +sendNotification(): void\n    }\n\n    %% Lớp Venue\n    class Venue {\n        -venueID: String\n        -venueName: String\n        -capacity: int\n        -facilities: String\n        +checkAvailability(): boolean\n        +viewDetails(): void\n    }\n\n    %% Mối quan hệ và bản số (Multiplicities)\n    Requester \&quot;1\&quot; -- \&quot;0..*\&quot; BookingRequest : submits &gt;\n    Venue \&quot;1\&quot; -- \&quot;0..*\&quot; BookingRequest : hosts &gt;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KjXcs_st2IxfQbwCziVe-101">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
