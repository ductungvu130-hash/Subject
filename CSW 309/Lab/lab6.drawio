        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: { &#39;theme&#39;: &#39;base&#39;, &#39;themeVariables&#39;: { &#39;primaryColor&#39;: &#39;#ffffff&#39;, &#39;primaryBorderColor&#39;: &#39;#333333&#39;, &#39;actorBkg&#39;: &#39;#f4f6f8&#39;, &#39;actorBorder&#39;: &#39;#333333&#39;, &#39;signalColor&#39;: &#39;#000000&#39;, &#39;signalTextColor&#39;: &#39;#000000&#39;, &#39;activationBorderColor&#39;: &#39;#333333&#39;, &#39;activationBkgColor&#39;: &#39;#e0e0e0&#39; } } }%%\nsequenceDiagram\n    autonumber\n    actor Staff as Facility Staff\n    participant UI as Web / Mobile Booking Portal\n    participant Approval as Booking Approval Component\n    participant Avail as Availability Checking Module\n    participant DB as Facility Booking Database\n    participant Notif as Notification Module\n\n    Staff-&gt;&gt;UI: openPendingRequest(requestId)\n    UI-&gt;&gt;Approval: getRequestDetails(requestId)\n    Approval-&gt;&gt;DB: fetch request &amp; facility data\n    DB--&gt;&gt;Approval: return request data\n    Approval--&gt;&gt;UI: return request details\n    UI--&gt;&gt;Staff: show request for review\n    \n    Staff-&gt;&gt;UI: submitDecision(result, note)\n    UI-&gt;&gt;Approval: submitDecision(requestId, staffId, result, note)\n\n    alt result = Approve and no conflict\n        Approval-&gt;&gt;Avail: checkFacilityAvailability(facilityId, date, start, end)\n        Avail--&gt;&gt;Approval: return AvailabilityStatus = Available\n        Approval-&gt;&gt;DB: save StaffDecision + create Booking; update status = Approved\n        DB--&gt;&gt;Approval: return success\n        Approval-&gt;&gt;Notif: sendDecisionNotification(studentId, requestId, status)\n        Notif--&gt;&gt;Approval: return DeliveryStatus = Sent\n    else conflict or Reject\n        Approval-&gt;&gt;DB: update status = Rejected / log conflict\n        DB--&gt;&gt;Approval: return success\n        Approval-&gt;&gt;Notif: sendDecisionNotification(studentId, requestId, status)\n        Notif--&gt;&gt;Approval: return DeliveryStatus = Sent\n        Approval--&gt;&gt;UI: return conflict / rejection result\n        UI--&gt;&gt;Staff: show conflict / confirmation\n    end\n\n    Approval--&gt;&gt;UI: return decision result\n    UI--&gt;&gt;Staff: show approval confirmation&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yzX0QciK7EGiFZ417H0b-1">
