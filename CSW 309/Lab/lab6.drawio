        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{\n  init: {\n    &#39;theme&#39;: &#39;base&#39;,\n    &#39;themeVariables&#39;: {\n      &#39;primaryColor&#39;: &#39;#ffffff&#39;,\n      &#39;primaryBorderColor&#39;: &#39;#000000&#39;,\n      &#39;primaryTextColor&#39;: &#39;#000000&#39;,\n      &#39;lineColor&#39;: &#39;#000000&#39;,\n      &#39;textColor&#39;: &#39;#000000&#39;\n    }\n  }\n}%%\nclassDiagram\n    direction TB\n\n    class User {\n        &lt;&lt;abstract&gt;&gt;\n        -userID: int\n        -fullName: string\n        -email: string\n        -password: string\n    }\n\n    class Requester {\n        -requesterType: string\n    }\n\n    class Staff {\n        -department: string\n    }\n\n    class Notification {\n        -notificationID: int\n        -message: string\n        -sentTime: datetime\n        -channel: string\n    }\n\n    class BookingRequest {\n        -requestID: int\n        -bookingDate: date\n        -startTime: time\n        -endTime: time\n        -purpose: string\n        -participantCount: int\n        -requestStatus: string\n        -submissionTime: datetime\n    }\n\n    class StaffDecision {\n        -decisionID: int\n        -decisionDate: date\n        -decisionResult: string\n        -decisionNote: string\n    }\n\n    class Facility {\n        -facilityID: int\n        -facilityName: string\n        -location: string\n        -capacity: int\n        -facilityType: string\n        -status: string\n    }\n\n    class Booking {\n        -bookingID: int\n        -bookingDate: date\n        -startTime: time\n        -endTime: time\n        -status: string\n    }\n\n    %% Quan hệ Kế thừa (Inheritance)\n    User &lt;|-- Requester\n    User &lt;|-- Staff\n\n    %% Quan hệ Liên kết (Association)\n    Requester \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notification : receives\n    Requester \&quot;1\&quot; --&gt; \&quot;0..*\&quot; BookingRequest : submits\n    Staff \&quot;1\&quot; --&gt; \&quot;0..*\&quot; StaffDecision : makes\n    BookingRequest \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Facility : for\n\n    %% Quan hệ Hợp thành (Composition) &amp; Tập hợp (Aggregation)\n    BookingRequest \&quot;1\&quot; *-- \&quot;0..1\&quot; StaffDecision : has decision\n    BookingRequest \&quot;1\&quot; o-- \&quot;0..1\&quot; Booking : creates&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yzX0QciK7EGiFZ417H0b-361">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
