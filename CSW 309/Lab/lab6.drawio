        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{\n  init: {\n    &#39;theme&#39;: &#39;base&#39;,\n    &#39;themeVariables&#39;: {\n      &#39;primaryColor&#39;: &#39;#ffffff&#39;,\n      &#39;primaryBorderColor&#39;: &#39;#000000&#39;,\n      &#39;primaryTextColor&#39;: &#39;#000000&#39;,\n      &#39;lineColor&#39;: &#39;#000000&#39;,\n      &#39;textColor&#39;: &#39;#000000&#39;,\n      &#39;clusterBkg&#39;: &#39;#ffffff&#39;,\n      &#39;clusterBorder&#39;: &#39;#000000&#39;\n    }\n  }\n}%%\nflowchart LR\n    %% Làn của người yêu cầu (Requester)\n    subgraph Requester [Requester]\n        Start((Start))\n        Submit([Submit Booking Request])\n        Receive([Receive Notification])\n        End1(((End)))\n    end\n\n    %% Làn của Hệ thống (System)\n    subgraph System [System]\n        Validate([Validate Request Information])\n        ValidGateway{Valid?}\n        SavePending([Save Pending Request])\n        SendRej([Send Rejection Notice])\n        End2(((End)))\n        \n        CreateBooking([Create Booking Record])\n        SendNotif([Send Notification])\n    end\n\n    %% Làn của Nhân viên cơ sở vật chất (Facility Staff)\n    subgraph FacilityStaff [Facility Staff]\n        Review([Review Request])\n        CheckAvail([Check Availability])\n        ApproveGateway{Approve?}\n        ApproveTask([Approve Request])\n        RejectTask([Reject Request])\n    end\n\n    %% Luồng đi bên trong và giữa các làn\n    Start --&gt; Submit\n    Submit --&gt; Validate\n    Validate --&gt; ValidGateway\n    \n    %% Xử lý tính hợp lệ của Request\n    ValidGateway -- Yes --&gt; SavePending\n    ValidGateway -- No --&gt; SendRej\n    SendRej --&gt; End2\n    \n    %% Luồng xem xét và duyệt\n    SavePending --&gt; Review\n    Review --&gt; CheckAvail\n    CheckAvail --&gt; ApproveGateway\n    \n    %% Quyết định duyệt hay từ chối\n    ApproveGateway -- Yes --&gt; ApproveTask\n    ApproveGateway -- No --&gt; RejectTask\n    \n    ApproveTask --&gt; CreateBooking\n    CreateBooking --&gt; SendNotif\n    RejectTask --&gt; SendNotif\n    \n    %% Kết thúc quy trình\n    SendNotif --&gt; Receive\n    Receive --&gt; End1\n    \n    %% Định dạng style cho các node giống với chuẩn BPMN nhất\n    classDef event fill:#ffffff,stroke:#000000,stroke-width:2px;\n    classDef task fill:#ffffff,stroke:#000000,stroke-width:1px;\n    classDef gateway fill:#ffffff,stroke:#000000,stroke-width:1.5px;\n    \n    class Start,End1,End2 event;\n    class ValidGateway,ApproveGateway gateway;\n    class Submit,Receive,Validate,SavePending,SendRej,CreateBooking,SendNotif,Review,CheckAvail,ApproveTask,RejectTask task;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yzX0QciK7EGiFZ417H0b-431">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="3870" width="2731" as="geometry" />
          </mxCell>
        </UserObject>
