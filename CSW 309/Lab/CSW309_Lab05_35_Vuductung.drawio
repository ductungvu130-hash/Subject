        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;stateDiagram-v2\n    %% Định nghĩa hướng của biểu đồ từ trái sang phải\n    direction LR\n\n    %% Các trạng thái của Appointment\n    state \&quot;Pending\&quot; as Pending\n    state \&quot;Confirmed\&quot; as Confirmed\n    state \&quot;Checked-in\&quot; as CheckedIn\n    state \&quot;Completed\&quot; as Completed\n    state \&quot;Cancelled\&quot; as Cancelled\n\n    %% Sự kiện bắt đầu\n    [*] --&gt; Pending : createAppointment() [Slot is available]\n\n    %% Các luồng chuyển đổi từ Pending\n    Pending --&gt; Confirmed : updateStatus(&#39;Confirmed&#39;)\n    Pending --&gt; Cancelled : updateStatus(&#39;Cancelled&#39;)\n\n    %% Các luồng chuyển đổi từ Confirmed\n    Confirmed --&gt; CheckedIn : updateStatus(&#39;Checked-in&#39;)\n    Confirmed --&gt; Cancelled : updateStatus(&#39;Cancelled&#39;)\n\n    %% Luồng chuyển đổi từ Checked-in\n    CheckedIn --&gt; Completed : updateStatus(&#39;Completed&#39;)\n\n    %% Các điểm kết thúc của vòng đời đối tượng\n    Cancelled --&gt; [*]\n    Completed --&gt; [*]&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hAFs9VL1gLX4TdqOTukf-325">
