        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Customer\n    participant ATM\n    participant BankSystem\n\n    Customer-&gt;&gt;ATM: selectTransaction(\&quot;Cash Withdrawal\&quot;)\n    activate ATM\n    ATM-&gt;&gt;Customer: displayAccountTypeOptions()\n    deactivate ATM\n\n    Customer-&gt;&gt;ATM: selectAccountType(accountType)\n    activate ATM\n    ATM-&gt;&gt;Customer: promptWithdrawalAmount()\n    deactivate ATM\n\n    Customer-&gt;&gt;ATM: enterAmount(amount)\n    activate ATM\n\n    ATM-&gt;&gt;BankSystem: checkBalance(accountType, amount)\n    activate BankSystem\n    BankSystem--&gt;&gt;ATM: balanceStatus\n    deactivate BankSystem\n\n    alt balance sufficient\n        ATM-&gt;&gt;ATM: checkCashAvailability(amount)\n\n        alt ATM has enough cash\n            ATM-&gt;&gt;ATM: dispenseCash(amount)\n\n            ATM-&gt;&gt;BankSystem: updateBalance(accountType, amount)\n            activate BankSystem\n            BankSystem--&gt;&gt;ATM: balanceUpdated\n            deactivate BankSystem\n\n            ATM-&gt;&gt;BankSystem: saveTransactionRecord(transactionDetails)\n            activate BankSystem\n            BankSystem--&gt;&gt;ATM: recordSaved\n            deactivate BankSystem\n\n            ATM-&gt;&gt;Customer: displayWithdrawalSuccess()\n            ATM-&gt;&gt;Customer: askPrintReceipt()\n\n            opt customer wants receipt\n                Customer-&gt;&gt;ATM: selectPrintReceipt(Yes)\n                ATM-&gt;&gt;ATM: printReceipt()\n                ATM-&gt;&gt;Customer: returnReceipt()\n            end\n\n        else ATM cash insufficient\n            ATM-&gt;&gt;Customer: displayError(\&quot;ATM out of cash\&quot;)\n        end\n\n    else balance insufficient\n        ATM-&gt;&gt;Customer: displayError(\&quot;Insufficient balance\&quot;)\n    end\n\n    deactivate ATM\n\n    ATM-&gt;&gt;Customer: displayMainMenu()&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6oE6ymslMdwxVcrzsTJQ-247">
