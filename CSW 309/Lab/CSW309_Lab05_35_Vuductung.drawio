        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    classDef default fill:#ffffff,stroke:#000000,color:#000000;\n\n    class Customer {\n        - customerName : String\n        + insertCard() : void\n    }\n    class Card {\n        - cardNumber : String\n        - pin : String\n        - status : String\n        + checkValidity() : boolean\n    }\n    class Account {\n        - accountNumber : String\n        - balance : Double\n        - accountType : String\n        + checkBalance() : Double\n        + updateBalance() : void\n    }\n    class Transaction {\n        - transactionID : String\n        - amount : Double\n        - date : Date\n        + saveTransaction() : void\n        + cancelTransaction() : void\n    }\n    class ATM {\n        - atmID : String\n        - status : String\n        + checkStatus() : void\n        + changeStatus() : void\n    }\n    class CashDispenser {\n        - cashLevel : Double\n        + dispenseCash() : void\n        + refillCash() : void\n    }\n    class BankSystem {\n        - systemID : String\n        + validatePIN() : boolean\n        + processTransaction() : void\n    }\n\n    Customer \&quot;1\&quot; -- \&quot;1..*\&quot; Card : owns\n    Customer \&quot;1\&quot; -- \&quot;1\&quot; ATM : uses\n    Card \&quot;1..*\&quot; -- \&quot;1..*\&quot; Account : linked to\n    Account \&quot;1\&quot; -- \&quot;0..*\&quot; Transaction : has\n    ATM \&quot;1\&quot; *-- \&quot;1\&quot; CashDispenser : contains\n    ATM \&quot;1..*\&quot; -- \&quot;1\&quot; BankSystem : connects to&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6oE6ymslMdwxVcrzsTJQ-142">
