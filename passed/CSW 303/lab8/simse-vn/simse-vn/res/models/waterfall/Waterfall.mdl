<beginParticipantAttributeRuleEffect>
ProductivityInTesting
(thisSoftwareEngineer-Employee:ProductivityInTestingUnadjusted * thisSoftwareEngineer-Employee:Energy) / (numActiveActionsThis-Emp-SoftwareEngineer-Employee:* - 1)  
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ErrorRateInTesting
(thisSoftwareEngineer-Employee:ErrorRateInTestingUnadjusted * (1 + 1 - thisSoftwareEngineer-Employee:Energy)) / (numActiveActionsThis-Emp-SoftwareEngineer-Employee:* - 1) 
<endParticipantAttributeRuleEffect>
<endParticipantTypeRuleEffect>
