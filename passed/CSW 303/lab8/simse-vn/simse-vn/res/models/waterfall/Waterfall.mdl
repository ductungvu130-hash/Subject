thisSoftwareEngineer-Employee:ErrorRateInRequirementsUnadjusted - ((thisSoftwareEngineer-Employee:ErrorRateInRequirementsUnadjusted * ((input-NewPayRate - thisSoftwareEngineer-Employee:PayRate) / thisSoftwareEngineer-Employee:PayRate)) / 2) 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ErrorRateInDesignUnadjusted
thisSoftwareEngineer-Employee:ErrorRateInDesignUnadjusted - ((thisSoftwareEngineer-Employee:ErrorRateInDesignUnadjusted * ((input-NewPayRate - thisSoftwareEngineer-Employee:PayRate) / thisSoftwareEngineer-Employee:PayRate)) / 2) 
<endParticipantAttributeRuleEffect>
