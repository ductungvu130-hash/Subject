thisSoftwareEngineer-Employee:ProductivityInCodingUnadjusted + ((thisSoftwareEngineer-Employee:ProductivityInCodingUnadjusted * ((input-NewPayRate - thisSoftwareEngineer-Employee:PayRate) / thisSoftwareEngineer-Employee:PayRate)) / 2) 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
