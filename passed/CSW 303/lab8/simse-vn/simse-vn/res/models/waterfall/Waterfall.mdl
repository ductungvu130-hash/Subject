ProductivityInRequirementsUnadjusted

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ProductivityInDesignUnadjusted

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ProductivityInCodingUnadjusted

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ErrorRateInRequirementsUnadjusted

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ErrorRateInDesignUnadjusted

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ErrorRateInCodingUnadjusted

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
RequirementsExperience

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
DesignExperience

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
CodingExperience

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
Name

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
Energy
thisSoftwareEngineer-Employee:Energy - .0025 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
Mood
thisSoftwareEngineer-Employee:Mood - .00125 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ProductivityInRequirements

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ProductivityInDesign

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ProductivityInCoding
(thisSoftwareEngineer-Employee:ProductivityInCodingUnadjusted * thisSoftwareEngineer-Employee:Energy) / (numActiveActionsThis-Emp-SoftwareEngineer-Employee:* - 1) 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ErrorRateInRequirements

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ErrorRateInDesign

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
ErrorRateInCoding
(thisSoftwareEngineer-Employee:ErrorRateInCodingUnadjusted * (1 + 1 - thisSoftwareEngineer-Employee:Energy)) / (numActiveActionsThis-Emp-SoftwareEngineer-Employee:* - 1) 
