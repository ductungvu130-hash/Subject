thisSoftwareEngineer-Employee:ProductivityInDesignUnadjusted + ((thisSoftwareEngineer-Employee:ProductivityInDesignUnadjusted * ((input-NewPayRate - thisSoftwareEngineer-Employee:PayRate) / thisSoftwareEngineer-Employee:PayRate)) / 2) 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
