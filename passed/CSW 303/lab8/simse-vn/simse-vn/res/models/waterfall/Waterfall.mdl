<beginParticipantAttributeRuleEffect>
CompletnessDiffReqDoc
(((all-AssociatedRequirementsDoc-RequirementsDocument-Artifact:PercentComplete - thisSystemTestPlan-Artifact:PercentComplete) / 100) + .001) * 100000 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
NumUnknownTemp

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
PercentErroneous
(thisSystemTestPlan-Artifact:NumKnownErrors + thisSystemTestPlan-Artifact:NumUnknownErrors) / (thisSystemTestPlan-Artifact:Size + .1) * 100 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
Name

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
NumUnknownErrors
thisSystemTestPlan-Artifact:NumUnknownErrors + (allActive-Emp-SoftwareEngineer-Employee:ErrorRateInTesting * (1 - (.01 * (num-Emp * (num-Emp - 1) / 2))) * (1 + (allActive-AssociatedRequirementsDoc-RequirementsDocument-Artifact:PercentErroneous / 100 * 20)) * (1 + (1 - allActive-AssociatedRequirementsDoc-RequirementsDocument-Artifact:PercentComplete / 100 / 2)) * (1 - allActive-TestingTool-AutomatedTestingTool-Tool:ErrorRateDecreaseFactor) * 2) 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
NumKnownErrors

<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
Size
thisSystemTestPlan-Artifact:Size + ((allActive-Emp-SoftwareEngineer-Employee:ProductivityInTesting * (1 - (.01 * (num-Emp * (num-Emp - 1) / 2))) * (1 + (2 * allActive-AssociatedRequirementsDoc-RequirementsDocument-Artifact:PercentComplete / 100)) * (1 + allActive-TestingTool-AutomatedTestingTool-Tool:ProductivityIncreaseFactor)) * 2) 
<endParticipantAttributeRuleEffect>
<beginParticipantAttributeRuleEffect>
PercentComplete
thisSystemTestPlan-Artifact:Size / allActive-Proj-SEProject-Project:RequiredSizeOfCode * 100 
<endParticipantAttributeRuleEffect>
<endParticipantTypeRuleEffect>
<endParticipantRuleEffect>
