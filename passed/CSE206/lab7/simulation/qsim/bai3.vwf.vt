`timescale 1 ps/ 1 ps
module assignment3_vlg_vec_tst();
// constants                                           
// general purpose registers
reg VDT_CLock;
reg VDT_Reset;
reg VDT_X;
// wires                                               
wire VDT_A;
wire VDT_B;

// assign statements (if any)                          
assignment3 i1 (
// port map - connection between master ports and signals/registers   
	.VDT_A(VDT_A),
	.VDT_B(VDT_B),
	.VDT_CLock(VDT_CLock),
	.VDT_Reset(VDT_Reset),
	.VDT_X(VDT_X)
);
initial 
begin 
#200000 $finish;
end 

// VDT_CLock
always
begin
	VDT_CLock = 1'b0;
	VDT_CLock = #5000 1'b1;
	#5000;
end 

// VDT_Reset
initial
begin
	VDT_Reset = 1'b0;
end 

// VDT_X
initial
begin
	VDT_X = 1'b1;
	VDT_X = #50000 1'b0;
end 
endmodule

