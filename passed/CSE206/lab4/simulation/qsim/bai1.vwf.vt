`timescale 1 ps/ 1 ps
module assignment1_vlg_vec_tst();
// constants                                           
// general purpose registers
reg VDT_Clock;
reg VDT_Reset;
reg VDT_Y;
// wires                                               
wire VDT_A;
wire VDT_B;
wire VDT_Z;

// assign statements (if any)                          
assignment1 i1 (
// port map - connection between master ports and signals/registers   
	.VDT_A(VDT_A),
	.VDT_B(VDT_B),
	.VDT_Clock(VDT_Clock),
	.VDT_Reset(VDT_Reset),
	.VDT_Y(VDT_Y),
	.VDT_Z(VDT_Z)
);
initial 
begin 
#200000 $finish;
end 

// VDT_Clock
always
begin
	VDT_Clock = 1'b0;
	VDT_Clock = #5000 1'b1;
	#5000;
end 

// VDT_Reset
initial
begin
	VDT_Reset = 1'b0;
end 

// VDT_Y
initial
begin
	VDT_Y = 1'b0;
	VDT_Y = #10000 1'b1;
	VDT_Y = #10000 1'b0;
end 
endmodule

