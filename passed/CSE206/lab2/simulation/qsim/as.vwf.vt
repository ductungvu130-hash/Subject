`timescale 1 ps/ 1 ps
module assignment2b_vlg_vec_tst();
// constants                                           
// general purpose registers
reg VDT_A;
reg VDT_C;
reg VDTC;
// wires                                               
wire VDT_OUT;

// assign statements (if any)                          
assignment2b i1 (
// port map - connection between master ports and signals/registers   
	.VDT_A(VDT_A),
	.VDT_C(VDT_C),
	.VDT_OUT(VDT_OUT),
	.VDTC(VDTC)
);
initial 
begin 
#200000 $finish;
end 

// VDT_A
always
begin
	VDT_A = 1'b0;
	VDT_A = #5000 1'b1;
	#5000;
end 

// VDT_C
initial
begin
	VDT_C = 1'b1;
	# 10000;
	repeat(9)
	begin
		VDT_C = 1'b0;
		VDT_C = #10000 1'b1;
		# 10000;
	end
	VDT_C = 1'b0;
end 

// VDTC
always
begin
	VDTC = 1'b0;
	VDTC = #10000 1'b1;
	#10000;
end 
endmodule

