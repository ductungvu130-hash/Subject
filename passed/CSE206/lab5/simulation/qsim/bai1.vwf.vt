`timescale 1 ps/ 1 ps
module assignment1_vlg_vec_tst();
// constants                                           
// general purpose registers
reg VDT_A;
reg VDT_EN;
// wires                                               
wire VDT_D0;
wire VDT_D1;

// assign statements (if any)                          
assignment1 i1 (
// port map - connection between master ports and signals/registers   
	.VDT_A(VDT_A),
	.VDT_D0(VDT_D0),
	.VDT_D1(VDT_D1),
	.VDT_EN(VDT_EN)
);
initial 
begin 
#200000 $finish;
end 

// VDT_A
initial
begin
	repeat(2)
	begin
		VDT_A = 1'b0;
		VDT_A = #10000 1'b1;
		# 10000;
	end
	VDT_A = 1'b0;
	VDT_A = #30000 1'b1;
	VDT_A = #30000 1'b0;
	VDT_A = #10000 1'b1;
	# 10000;
	repeat(4)
	begin
		VDT_A = 1'b0;
		VDT_A = #10000 1'b1;
		# 10000;
	end
end 

// VDT_EN
initial
begin
	VDT_EN = 1'b1;
	VDT_EN = #30000 1'b0;
	VDT_EN = #10000 1'b1;
	VDT_EN = #10000 1'b0;
	VDT_EN = #10000 1'b1;
	VDT_EN = #30000 1'b0;
	VDT_EN = #10000 1'b1;
	# 10000;
	repeat(4)
	begin
		VDT_EN = 1'b0;
		VDT_EN = #10000 1'b1;
		# 10000;
	end
	VDT_EN = 1'b0;
end 
endmodule

