`timescale 1 ps/ 1 ps
module assignment4_vlg_vec_tst();
// constants                                           
// general purpose registers
reg VDT_A0;
reg VDT_A1;
reg VDT_S;
// wires                                               
wire VDT_Y;

// assign statements (if any)                          
assignment4 i1 (
// port map - connection between master ports and signals/registers   
	.VDT_A0(VDT_A0),
	.VDT_A1(VDT_A1),
	.VDT_S(VDT_S),
	.VDT_Y(VDT_Y)
);
initial 
begin 
#200000 $finish;
end 

// VDT_A0
initial
begin
	repeat(2)
	begin
		VDT_A0 = 1'b0;
		VDT_A0 = #10000 1'b1;
		# 10000;
	end
	VDT_A0 = 1'b0;
	VDT_A0 = #30000 1'b1;
	VDT_A0 = #10000 1'b0;
	VDT_A0 = #10000 1'b1;
	# 10000;
	repeat(5)
	begin
		VDT_A0 = 1'b0;
		VDT_A0 = #10000 1'b1;
		# 10000;
	end
end 

// VDT_A1
initial
begin
	VDT_A1 = 1'b1;
	VDT_A1 = #50000 1'b0;
	VDT_A1 = #30000 1'b1;
	# 10000;
	repeat(5)
	begin
		VDT_A1 = 1'b0;
		VDT_A1 = #10000 1'b1;
		# 10000;
	end
	VDT_A1 = 1'b0;
end 

// VDT_S
always
begin
	VDT_S = 1'b0;
	VDT_S = #10000 1'b1;
	#10000;
end 
endmodule

