`timescale 1 ps/ 1 ps
module assignment1_vlg_vec_tst();
// constants                                           
// general purpose registers
reg VDT_A;
reg VDT_B;
// wires                                               
wire pin_name2;

// assign statements (if any)                          
assignment1 i1 (
// port map - connection between master ports and signals/registers   
	.pin_name2(pin_name2),
	.VDT_A(VDT_A),
	.VDT_B(VDT_B)
);
initial 
begin 
#1000000 $finish;
end 

// VDT_A
always
begin
	VDT_A = 1'b0;
	VDT_A = #10000 1'b1;
	#10000;
end 

// VDT_B
initial
begin
	VDT_B = 1'b1;
end 
endmodule

