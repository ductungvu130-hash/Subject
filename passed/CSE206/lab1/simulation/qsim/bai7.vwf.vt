`timescale 1 ps/ 1 ps
module assignmet7_vlg_vec_tst();
// constants                                           
// general purpose registers
reg VDT1;
reg VDT2;
// wires                                               
wire out;

// assign statements (if any)                          
assignmet7 i1 (
// port map - connection between master ports and signals/registers   
	.out(out),
	.VDT1(VDT1),
	.VDT2(VDT2)
);
initial 
begin 
#200000 $finish;
end 

// VDT1
always
begin
	VDT1 = 1'b0;
	VDT1 = #10000 1'b1;
	#10000;
end 

// VDT2
initial
begin
	VDT2 = 1'b1;
	# 5000;
	repeat(19)
	begin
		VDT2 = 1'b0;
		VDT2 = #5000 1'b1;
		# 5000;
	end
	VDT2 = 1'b0;
end 
endmodule

